    "n": 1,
    "required": false,
    "pages": [
      "products-fluids-ansys-fluent"
    ],
    "templates": [
      "landing",
      "program"
    ],
    "note": "carousel: only slide 1 is on-canvas; slides 2+ sit off-canvas (clipped) identically on live and build, so the family measures slide 1 only; advisory"
  },
